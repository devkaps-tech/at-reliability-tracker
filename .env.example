# Copy this file to .env and fill in your values. .env is in .gitignore so it never reaches GitHub.

# Your key from the AT dev portal (Realtime Compat API)
AT_API_KEY=

# Optional: where to send "no data" alerts (a Slack incoming-webhook URL or an ntfy.sh topic URL).
# Leave blank to get Mac notifications only.
ALERT_WEBHOOK_URL=
